# Leave API_BASE_URL empty to use the API built into this app (pages/api/v1),
# which reads the content in data/. Set it to an external host to proxy there
# instead — the front end's request shapes are unchanged either way.
API_BASE_URL=
# Where the browser sends api/v1 calls. "/" keeps them on this origin.
NEXT_PUBLIC_API_BASE_URL=/

PREVIEW_VERSION=draft

ASSET_PREFIX=
NEXT_PUBLIC_META_IMAGE=

NEXT_PUBLIC_ASSET_DOMAIN=
NEXT_PUBLIC_GA_ID=

REVALIDATE_CONTENT_IN_SECONDS=60
REVALIDATE_SECRET_TOKEN=

TIMEZONE=Asia/Singapore

SITE_URL=http://localhost:3000
